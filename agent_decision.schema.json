:root{font-family:Inter,ui-sans-serif,system-ui,Segoe UI,Arial;background:#050806;color:#e7ffee}*{box-sizing:border-box}body{margin:0}.app{min-height:100vh;display:grid;grid-template-columns:300px 1fr;background:radial-gradient(circle at top left,#103d2e 0,#06110d 35%,#020403 100%)}.sidebar{border-right:1px solid #143b2b;background:rgba(2,8,5,.86);padding:18px;display:flex;flex-direction:column;gap:16px;position:sticky;top:0;height:100vh}.brand{display:flex;align-items:center;gap:10px;color:#3dff9b}.brand span{display:block;color:#84a996;font-size:12px}.target-form{display:flex;gap:8px;flex-direction:column}.target-form input,input{background:#07140f;border:1px solid #1d5b41;color:#e7ffee;border-radius:14px;padding:12px}.target-form button,button{background:#0d2119;color:#e7ffee;border:1px solid #245f46;border-radius:14px;padding:10px 12px;display:inline-flex;gap:8px;align-items:center;justify-content:center;cursor:pointer}button:hover{border-color:#37ff9b}.primary{background:linear-gradient(135deg,#0dbf6f,#12f29a)!important;color:#02110b!important;border:0!important;font-weight:800}.target-list{display:flex;flex-direction:column;gap:8px}.target-list button{align-items:flex-start;flex-direction:column}.target-list .active,nav .active{border-color:#37ff9b;background:#0e2c20}nav{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:auto}nav button{text-transform:capitalize}main{padding:22px;overflow:auto}.topbar{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:20px}.topbar h1{margin:0;font-size:32px}.topbar p{margin:6px 0 0;color:#9ecab3}.actions{display:flex;gap:10px;flex-wrap:wrap}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.dash{grid-template-columns:repeat(3,minmax(0,1fr))}.wide{grid-column:1/-1}.card{background:rgba(5,17,12,.82);border:1px solid #164631;border-radius:24px;padding:18px;box-shadow:0 20px 60px rgba(0,0,0,.25)}.card h2,.card h3{margin-top:0}.hero{background:linear-gradient(145deg,rgba(9,45,31,.95),rgba(5,17,12,.9));border-color:#1ce489}.hero-row{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.metric-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}.metric{background:#07140f;border:1px solid #164631;border-radius:18px;padding:14px;text-align:center}.metric b{display:block;font-size:26px;color:#3dff9b}.metric span{font-size:12px;color:#9ecab3}.quick{display:flex;gap:8px;flex-wrap:wrap}.badge{border:1px solid #365044;border-radius:999px;font-size:11px;padding:4px 8px;color:#b9d8c6;background:#0d1c16}.badge.good{background:#082718;color:#45ffa2;border-color:#1bbf77}.badge.danger{background:#2d0b0b;color:#ff7878;border-color:#a83232}.badge.warn{background:#2c2208;color:#ffd36a;border-color:#9a741a}.empty{color:#789986;background:#07120d;border:1px dashed #244d3a;border-radius:16px;padding:18px}.row,.job,.finding,.cred,.timeline,.action{display:flex;gap:10px;align-items:center;border-top:1px solid #143b2b;padding:11px 0}.row code,.job small,.action code{color:#83d4aa;overflow:hidden;text-overflow:ellipsis}.job{display:grid;grid-template-columns:12px 1fr auto;align-items:center}.job small{grid-column:2/-1}.dot{width:10px;height:10px;border-radius:50%;background:#7a8790}.dot.completed{background:#3dff9b}.dot.failed,.dot.blocked{background:#ff5e5e}.dot.running,.dot.queued{background:#ffd36a}.approval{border:1px solid #5b2b2b;background:#160c0c;border-radius:18px;padding:14px;margin:10px 0}.approval>div{display:flex;gap:8px;align-items:center;justify-content:space-between}.approval code,.action code{display:block;margin:10px 0;padding:10px;border-radius:12px;background:#020806;color:#8cffbd;white-space:pre-wrap}.finding,.cred{justify-content:space-between}.timeline{display:grid;grid-template-columns:20px 180px 1fr;color:#9ecab3}.report{white-space:pre-wrap;background:#020806;border:1px solid #163c2c;border-radius:18px;padding:18px;max-height:70vh;overflow:auto;color:#d9ffe7}@media(max-width:900px){.app{display:block}.sidebar{height:auto;position:relative}.topbar{display:block}.actions{margin-top:12px}.grid,.dash{grid-template-columns:1fr}.metric-row{grid-template-columns:repeat(2,1fr)}.timeline{grid-template-columns:20px 1fr}.timeline small{grid-column:2}.sidebar nav{grid-template-columns:repeat(3,1fr)}}
