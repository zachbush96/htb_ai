# Copy this file to .env for non-secret local defaults.
# The backend loads .env first and then .htb-codex.env without overriding
# existing values. Put private tokens and hostnames in .htb-codex.env, but do
# not define the same key here unless you want this file's value to win.

# Backend bind address and port used by scripts/run_dev.sh.
HTBMC_BIND_HOST=127.0.0.1
HTBMC_PORT=8000

# File-backed runtime state. This directory receives target records, logs,
# artifacts, LLM traces, and runtime settings while the project runs.
HTBMC_STATE_DIR=./state

# Enumeration settings used by backend/htbmc/app.py::_build_nmap_command.
HTBMC_NMAP_BIN=nmap
HTBMC_SCAN_TIMEOUT_SECONDS=1200

# LLM/Ollama settings. Set exactly one base path when possible. Use
# OLLAMA_BASE_URL for a full URL or OLLAMA_TAILSCALE_HOST for host:port.
OLLAMA_TAILSCALE_HOST=
OLLAMA_BASE_URL=
HTBMC_OLLAMA_TIMEOUT_SECONDS=5
